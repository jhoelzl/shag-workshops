// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`email templates snapshots > matches confirmation template snapshot (DE) 1`] = `
"<h2>Hallo Max Mustermann!</h2>
               <p>Deine Anmeldung für <strong>Collegiate Shag Beginner</strong> wurde <strong>bestätigt</strong>!</p>
               <p>Wir freuen uns auf dich!</p>
               <p>Vera & Josef</p>"
`;

exports[`email templates snapshots > matches confirmation template snapshot (EN) 1`] = `
"<h2>Hello Alex Example!</h2>
               <p>Your registration for <strong>Collegiate Shag Beginner</strong> has been <strong>confirmed</strong>!</p>
               <p>We look forward to seeing you!</p>
               <p>Vera & Josef</p>"
`;

exports[`email templates snapshots > matches wrapHtml snapshot 1`] = `
"<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="x-apple-disable-message-reformatting">
<title>Status update</title>
</head>
<body style="margin:0;padding:0;background-color:#fdf6ee;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2937;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;">Short preview text</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf6ee;">
  <tr>
    <td align="center" style="padding:24px 12px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;background-color:#ffffff;border-radius:8px;padding:32px;">
        <tr>
          <td style="font-size:16px;line-height:1.6;color:#1f2937;">
<h2>Test heading</h2><p>Body content.</p>
          </td>
        </tr>
      </table>
      <p style="font-size:12px;color:#6b7280;margin:16px 0 0;">Amadeus Shagadeus · Collegiate Shag in Salzburg · <a href="https://shagadeus.at" style="color:#6b7280;">shagadeus.at</a></p>
    </td>
  </tr>
</table>
</body>
</html>"
`;
