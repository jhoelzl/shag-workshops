---
// A5 printable flyer / give-away
// Open at /flyer/ — print at 100% on A5 (or 2-up on A4)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flyer · Amadeus Shagadeus</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="stylesheet" href="/src/styles/global.css" />
    <style>
      @page { size: A5; margin: 0; }
      html, body { margin: 0; padding: 0; background: #2b2f45; }
      body { font-family: 'Inter', system-ui, sans-serif; }

      .flyer {
        width: 148mm;
        height: 210mm;
        margin: 12mm auto;
        position: relative;
        overflow: hidden;
        background:
          radial-gradient(at 12% 0%, rgba(231, 111, 81, 0.18) 0px, transparent 45%),
          radial-gradient(at 88% 6%, rgba(42, 157, 143, 0.16) 0px, transparent 45%),
          radial-gradient(at 50% 100%, rgba(212, 168, 50, 0.14) 0px, transparent 50%),
          #FBF6EE;
        color: #161a23;
        box-shadow: 0 30px 60px -20px rgba(0,0,0,0.4);
        border-radius: 4mm;
      }

      .flyer .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(40px);
        opacity: 0.55;
        pointer-events: none;
        z-index: 0;
      }

      .flyer .content { position: relative; z-index: 1; padding: 10mm 9mm; height: 100%; box-sizing: border-box; display: flex; flex-direction: column; }

      .eyebrow {
        font-size: 8pt;
        font-weight: 700;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: #1f7a70;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: rgba(255,255,255,0.7);
        border: 1px solid rgba(42, 157, 143, 0.25);
        padding: 4px 10px;
        border-radius: 999px;
      }
      .eyebrow .dot { width: 6px; height: 6px; border-radius: 50%; background: #2A9D8F; }

      .headline {
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 900;
        font-size: 38pt;
        line-height: 0.95;
        color: #0f1a30;
        letter-spacing: -0.015em;
        margin: 6mm 0 2mm;
      }
      .headline .italic {
        font-style: italic;
        font-weight: 400;
        display: inline-block;
        margin-top: 2mm;
        padding-bottom: 3mm;
        line-height: 1.05;
        background: linear-gradient(135deg, #E76F51 0%, #d4a832 60%, #E76F51 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .sub {
        font-size: 11pt;
        color: #5b6273;
        line-height: 1.45;
        max-width: 95%;
        margin: 0 0 6mm;
      }

      .hero-row { display: flex; align-items: center; gap: 5mm; }
      .hero-text { flex: 1; }
      .logo-wrap {
        flex: 0 0 80mm;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-left: -15mm;
      }
      .logo-glow {
        position: absolute; inset: -10mm;
        background: radial-gradient(circle, rgba(231,111,81,0.30) 0%, rgba(42,157,143,0.20) 50%, transparent 70%);
        filter: blur(20px);
      }
      .logo-wrap img {
        position: relative;
        width: 80mm;
        height: auto;
        transform: rotate(-3deg);
        filter: drop-shadow(0 10px 16px rgba(15,26,48,0.25));
      }

      .divider {
        display: flex; align-items: center; gap: 4mm;
        margin: -8mm 0 4mm;
      }
      .divider .line { flex: 1; height: 1px; background: linear-gradient(to right, transparent, rgba(15,26,48,0.18), transparent); }
      .divider .star { color: #d4a832; font-size: 14pt; }

      .courses { display: grid; grid-template-columns: 1fr 1fr; gap: 4mm; }
      .card {
        background: #ffffff;
        border-radius: 3mm;
        padding: 0;
        box-shadow:
          0 1px 2px rgba(15, 26, 48, 0.05),
          0 14px 28px -14px rgba(15, 26, 48, 0.18);
        position: relative;
        overflow: hidden;
        display: flex;
        flex-direction: column;
      }
      .card::before {
        content: '';
        position: absolute; top: 0; left: 0; right: 0; height: 4px;
        background: linear-gradient(90deg, #E76F51, #d4a832, #2A9D8F);
      }
      .card-body {
        padding: 5mm 4mm 4mm;
        display: flex;
        flex-direction: column;
        flex: 1;
      }
      .card .label {
        display: flex; justify-content: space-between; align-items: center;
        margin-bottom: 2.5mm;
      }
      .card .kicker {
        font-size: 7pt; font-weight: 700; letter-spacing: 0.16em;
        text-transform: uppercase; color: #E76F51;
      }
      .card .level {
        font-size: 7pt; font-weight: 700;
        background: rgba(42,157,143,0.12);
        color: #1f7a70;
        padding: 2px 7px; border-radius: 999px;
      }
      .card h3 {
        font-family: 'Fraunces', Georgia, serif;
        font-size: 15pt;
        font-weight: 700;
        color: #0f1a30;
        margin: 0 0 3mm;
        letter-spacing: -0.01em;
        line-height: 1.1;
      }
      .card .meta {
        font-size: 9pt; color: #161a23; line-height: 1.4;
        display: flex; flex-direction: column; gap: 1.8mm;
      }
      .card .meta .row { display: block; }
      .card .meta .row strong {
        color: #0f1a30;
        font-weight: 600;
        display: inline;
        margin-right: 4px;
      }
      .card .price {
        margin-top: 3mm;
        font-size: 9pt;
        color: #1f7a70;
        font-weight: 600;
      }
      .card .when-where {
        margin-top: auto;
        background: linear-gradient(180deg, rgba(231,111,81,0.07), rgba(212,168,50,0.07));
        border-top: 1px solid rgba(15,26,48,0.08);
        padding: 3mm 4mm 3.5mm;
        display: flex;
        flex-direction: column;
        gap: 1.2mm;
      }
      .card .ww-row {
        display: flex;
        align-items: baseline;
        gap: 2mm;
        font-size: 9.5pt;
        color: #0f1a30;
        line-height: 1.3;
      }
      .card .ww-icon {
        flex: 0 0 auto;
        width: 4mm;
        height: 4mm;
        color: #1f7a70;
        line-height: 1;
        transform: translateY(0.4mm);
      }
      .card .ww-row:nth-child(2) .ww-icon { color: #E76F51; }
      .card .ww-icon svg { width: 100%; height: 100%; display: block; }
      .card .ww-text { font-weight: 600; }
      .card .teachers {
        font-size: 8pt; color: #5b6273; font-style: italic;
        margin-bottom: 2mm;
      }

      .footer {
        margin-top: auto;
        padding-top: 5mm;
        border-top: 1px solid rgba(15,26,48,0.08);
        display: flex; justify-content: space-between; align-items: center;
        gap: 4mm;
      }
      .footer .left { font-size: 9pt; color: #161a23; line-height: 1.35; }
      .footer .left strong { color: #0f1a30; }
      .footer .footer-url {
        margin-top: 2.5mm;
        font-family: 'Fraunces', Georgia, serif;
        font-weight: 700;
        font-size: 18pt;
        letter-spacing: -0.01em;
        color: #0f1a30;
      }
      .footer .url {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        font-size: 10pt;
        color: #0f1a30;
        background: linear-gradient(90deg, rgba(231,111,81,0.18), rgba(212,168,50,0.18));
        padding: 3mm 4mm;
        border-radius: 2mm;
        white-space: nowrap;
      }
      .footer .qr {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.5mm;
        background: #fff;
        padding: 2mm 2mm 1.5mm;
        border-radius: 2mm;
        box-shadow: 0 6px 16px -8px rgba(15,26,48,0.25);
      }
      .footer .qr img {
        width: 22mm;
        height: 22mm;
        display: block;
      }
      .footer .qr-url {
        font-family: 'JetBrains Mono', monospace;
        font-weight: 600;
        font-size: 7pt;
        color: #0f1a30;
        letter-spacing: 0.02em;
      }

      @media print {
        body { background: #fff; }
        .flyer { margin: 0; box-shadow: none; border-radius: 0; }
        .print-hint { display: none !important; }
      }

      .print-hint {
        position: fixed; top: 12px; right: 12px; z-index: 10;
        display: flex; gap: 8px; align-items: center;
        background: #0f1a30; color: #fff; padding: 8px 10px 8px 14px;
        font-size: 12px; border-radius: 8px;
        font-family: 'Inter', sans-serif;
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
      }
      .print-hint button {
        background: #fff; color: #0f1a30;
        border: 0; padding: 6px 12px; border-radius: 6px;
        font-size: 12px; font-weight: 600; font-family: inherit;
        cursor: pointer;
      }
      .print-hint button:hover { background: #d4a832; color: #0f1a30; }
      .print-hint button:disabled { opacity: 0.6; cursor: wait; }
    </style>
  </head>
  <body>
    <div class="print-hint">
      <span>A5 Flyer</span>
      <button id="btn-pdf" type="button" title="Druck-Dialog → Als PDF speichern">PDF (Print)</button>
      <span style="opacity:0.6; font-size:11px;" title="für pixelgenauen Export: npm run flyer:export">npm run flyer:export</span>
    </div>

    <div class="flyer">
      <!-- decorative blobs -->
      <div class="blob" style="background:#E76F51; width:80mm; height:80mm; top:-30mm; left:-25mm;"></div>
      <div class="blob" style="background:#2A9D8F; width:70mm; height:70mm; top:60mm; right:-20mm;"></div>
      <div class="blob" style="background:#d4a832; width:60mm; height:60mm; bottom:-20mm; left:30mm; opacity:0.35;"></div>

      <div class="content">
        <!-- Hero -->
        <div class="hero-row">
          <div class="hero-text">
            <h1 class="headline">
              Collegiate<br/>
              Shag<br/>
              <span class="italic">Salzburg</span>
            </h1>
            <p class="sub">Energiegeladene Swing-Tanzkurse für schnelle Jazz-Musik.</p>
          </div>
          <div class="logo-wrap">
            <div class="logo-glow"></div>
            <img src={`${base}/shagadeus_logo.png`} alt="Amadeus Shagadeus" />
          </div>
        </div>

        <div class="divider">
          <span class="line"></span>
          <span class="star">✦</span>
          <span style="font-family:'Fraunces',serif; font-size:11pt; font-weight:700; color:#0f1a30; letter-spacing:-0.01em;">Aktuelle Workshops</span>
          <span class="star">✦</span>
          <span class="line"></span>
        </div>

        <!-- Courses -->
        <div class="courses">
          <div class="card">
            <div class="card-body">
              <div class="label">
                <span class="kicker">Collegiate Shag</span>
                <span class="level">Beginner</span>
              </div>
              <h3>Eine kleine Shagmusik</h3>
              <div class="meta">
                <div class="row"><strong>Vorkenntnisse:</strong><span>keine</span></div>
                <div class="row"><strong>Inhalt:</strong><span>Grundschritte & einfache Figuren</span></div>
              </div>
              <div class="price">Freiwillige Spende<br />Zur Deckung der Saalmiete</div>
            </div>
            <div class="when-where">
              <div class="ww-row">
                <span class="ww-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
                <span class="ww-text">Do., 18. Juni · 18:00–18:55</span>
              </div>
              <div class="ww-row">
                <span class="ww-icon"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg></span>
                <span class="ww-text">Pfarre St. Severin, Salzburg</span>
              </div>
            </div>
          </div>

          <div class="card">
            <div class="card-body">
              <div class="label">
                <span class="kicker">Collegiate Shag</span>
                <span class="level">Improver</span>
              </div>
              <h3>Shag Me Amadeus</h3>
              <div class="meta">
                <div class="row"><strong>Vorkenntnisse:</strong><span>Grundschritte in geschlossener und offener Position</span></div>
                <div class="row"><strong>Inhalt:</strong><span>Neue Figuren und Breaks</span></div>
              </div>
              <div class="price">Freiwillige Spende<br />Zur Deckung der Saalmiete</div>
            </div>
            <div class="when-where">
              <div class="ww-row">
                <span class="ww-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg></span>
                <span class="ww-text">Do., 18. Juni · 19:00–19:55</span>
              </div>
              <div class="ww-row">
                <span class="ww-icon"><svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg></span>
                <span class="ww-text">Pfarre St. Severin, Salzburg</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Footer -->
        <div class="footer">
          <div class="left">
            <strong>Anmeldung & Infos</strong><br/>
            Besuche die Website für alle Termine.
            <div class="footer-url">shagadeus.at</div>
          </div>
          <div class="qr">
            <img
              src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=0&data=https%3A%2F%2Fshagadeus.at%2Fde%2Fworkshops%2F"
              alt="QR Code zu shagadeus.at"
            />
            <span class="qr-url">shagadeus.at</span>
          </div>
        </div>
      </div>
    </div>

    <script type="module">
      const btnPdf = document.getElementById('btn-pdf');
      btnPdf?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
