---
// A5 printable flyer / give-away — Art-Deco vinyl-cover design (1930s jazz aesthetic)
// Open at /flyer3/ — print at 100% on A5 (or 2-up on A4)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Flyer · Amadeus Shagadeus</title>
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Anton&family=Limelight&family=Cormorant+Garamond:ital,wght@0,500;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap"
    />
    <style>
      :root {
        --ink:     #0b0d1a;
        --cream:   #f3e8cd;
        --cream-2: #ecdcb6;
        --gold:    #d4a72c;
        --gold-d:  #a87f15;
        --burgundy:#8e2a2a;
        --rust:    #c4502b;
        --teal:    #1f6f6a;
      }

      @page { size: A5; margin: 0; }
      html, body { margin: 0; padding: 0; background: #1a1d2e; }
      body { font-family: 'Inter', system-ui, sans-serif; color: var(--ink); }

      /* ------- canvas ------- */
      .flyer {
        width: 148mm;
        height: 210mm;
        margin: 12mm auto;
        position: relative;
        overflow: hidden;
        background: var(--ink);
        box-shadow: 0 30px 60px -20px rgba(0,0,0,0.5);
      }

      /* art-deco sunburst behind the hero (top half) */
      .sunburst {
        position: absolute;
        left: 50%; top: -40mm;
        width: 240mm; height: 240mm;
        transform: translateX(-50%);
        background:
          repeating-conic-gradient(
            from 0deg at 50% 50%,
            var(--gold) 0deg 6deg,
            transparent 6deg 12deg
          );
        opacity: 0.12;
        pointer-events: none;
        z-index: 0;
      }

      /* gold decorative frame inset from edge */
      .frame {
        position: absolute;
        inset: 4mm;
        border: 0.6mm double var(--gold);
        pointer-events: none;
        z-index: 1;
      }
      .frame::before, .frame::after {
        content: '';
        position: absolute;
        inset: 1.5mm;
        border: 0.2mm solid rgba(212,167,44,0.5);
        pointer-events: none;
      }

      /* content layer */
      .content {
        position: relative;
        z-index: 2;
        padding: 9mm 10mm 8mm;
        height: 100%;
        box-sizing: border-box;
        display: flex; flex-direction: column;
        color: var(--cream);
      }

      /* ------- top mark ------- */
      .top-mark {
        text-align: center;
        margin-bottom: 1mm;
      }
      .top-mark .est {
        font-family: 'Limelight', serif;
        font-size: 7.5pt;
        letter-spacing: 0.35em;
        color: var(--gold);
        text-transform: uppercase;
      }
      .top-mark .divider {
        display: flex; align-items: center; justify-content: center;
        gap: 2mm; margin-top: 1.2mm;
        color: var(--gold);
      }
      .top-mark .divider .bar {
        height: 0.25mm; width: 16mm;
        background: var(--gold);
      }
      .top-mark .divider .diamond {
        width: 1.6mm; height: 1.6mm;
        background: var(--gold);
        transform: rotate(45deg);
      }

      /* ------- hero / title ------- */
      .hero {
        text-align: center;
        margin-top: 0.5mm;
      }
      .hero .pres {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 10pt;
        color: var(--cream);
        opacity: 0.85;
        margin-bottom: 0.5mm;
      }
      .hero h1 {
        font-family: 'Anton', 'Oswald', sans-serif;
        font-weight: 400;
        font-size: 48pt;
        line-height: 0.85;
        letter-spacing: -0.005em;
        margin: 0;
        color: var(--cream);
        text-transform: uppercase;
      }
      .hero h1 .collegiate {
        display: block;
        font-size: 22pt;
        letter-spacing: 0.16em;
        color: var(--gold);
        margin-bottom: 0.8mm;
      }
      .hero h1 .shag {
        display: block;
        position: relative;
        font-size: 60pt;
        line-height: 0.85;
      }
      .hero h1 .shag::before,
      .hero h1 .shag::after {
        content: '';
        position: absolute;
        top: 50%;
        width: 12mm; height: 0.4mm;
        background: var(--gold);
      }
      .hero h1 .shag::before { left: 10mm; }
      .hero h1 .shag::after  { right: 10mm; }
      .hero .tag {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 11pt;
        color: var(--cream);
        margin-top: 1.5mm;
        letter-spacing: 0.02em;
      }

      /* ------- vinyl record visual ------- */
      .record-wrap {
        margin: 4mm auto 3mm;
        position: relative;
        width: 60mm; height: 60mm;
      }
      .record {
        position: absolute; inset: 0;
        border-radius: 50%;
        background:
          radial-gradient(circle at 50% 50%, #0a0a14 0 18%, transparent 18.5%),
          repeating-radial-gradient(circle at 50% 50%,
            #1a1a28 0 0.4mm,
            #0a0a14 0.4mm 0.8mm
          );
        box-shadow:
          inset 0 0 0 0.3mm var(--gold-d),
          0 6px 18px rgba(0,0,0,0.4);
      }
      .record .label {
        position: absolute;
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        width: 22mm; height: 22mm;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 35%, var(--rust), var(--burgundy));
        box-shadow: inset 0 0 0 0.3mm var(--gold);
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        color: var(--cream);
        text-align: center;
        line-height: 1.1;
      }
      .record .label .hole {
        position: absolute;
        left: 50%; top: 50%;
        transform: translate(-50%, -50%);
        width: 1.6mm; height: 1.6mm;
        border-radius: 50%;
        background: var(--ink);
      }
      .record .label .lbl-top {
        font-family: 'Limelight', serif;
        font-size: 5pt;
        letter-spacing: 0.18em;
        color: var(--gold);
        text-transform: uppercase;
        position: absolute;
        top: 2.5mm;
      }
      .record .label .lbl-bot {
        font-family: 'Limelight', serif;
        font-size: 5pt;
        letter-spacing: 0.18em;
        color: var(--gold);
        text-transform: uppercase;
        position: absolute;
        bottom: 2.5mm;
      }
      .record .label .lbl-mid {
        font-family: 'Anton', sans-serif;
        font-size: 7.5pt;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin-top: -0.5mm;
      }
      /* spinning shine */
      .record::after {
        content: '';
        position: absolute; inset: 0;
        border-radius: 50%;
        background:
          conic-gradient(from 30deg,
            transparent 0deg,
            rgba(255,255,255,0.06) 18deg,
            transparent 36deg,
            transparent 180deg,
            rgba(255,255,255,0.04) 200deg,
            transparent 220deg
          );
        pointer-events: none;
      }
      /* needle / arm hint */
      .needle {
        position: absolute;
        right: -6mm; top: 2mm;
        width: 22mm; height: 1.4mm;
        background: linear-gradient(90deg, var(--gold) 0%, var(--gold-d) 100%);
        transform: rotate(28deg);
        transform-origin: right center;
        border-radius: 0.7mm;
        box-shadow: 0 0.4mm 1mm rgba(0,0,0,0.5);
      }
      .needle::before {
        content: '';
        position: absolute;
        right: -1.4mm; top: -1.4mm;
        width: 4mm; height: 4mm;
        border-radius: 50%;
        background: var(--gold-d);
        box-shadow: inset 0 0 0 0.4mm var(--gold);
      }
      .needle::after {
        content: '';
        position: absolute;
        left: -1mm; top: 50%;
        width: 2.2mm; height: 2.2mm;
        background: var(--cream);
        transform: translateY(-50%) rotate(45deg);
      }

      /* ------- ornamental divider ------- */
      .ornament-row {
        display: flex; align-items: center; justify-content: center;
        gap: 3mm;
        margin: 4mm 0 3mm;
        color: var(--gold);
      }
      .ornament-row .orn-bar {
        height: 0.3mm; width: 22mm;
        background: linear-gradient(90deg, transparent, var(--gold), transparent);
      }
      .ornament-row .orn-diamond {
        width: 1.8mm; height: 1.8mm;
        background: var(--gold);
        transform: rotate(45deg);
      }
      .ornament-row .orn-star {
        font-size: 13pt;
        color: var(--gold);
        line-height: 1;
      }

      /* ------- when (date) ------- */
      .when {
        text-align: center;
        margin: 0 0 2mm;
        color: var(--gold);
      }
      .when .day {
        font-family: 'Limelight', serif;
        font-size: 8.5pt;
        letter-spacing: 0.32em;
        text-transform: uppercase;
      }
      .when .date {
        font-family: 'Anton', sans-serif;
        font-size: 18pt;
        letter-spacing: 0.06em;
        color: var(--cream);
        text-transform: uppercase;
        margin-top: 0.5mm;
      }
      .when .year {
        display: inline-block;
        margin-left: 2mm;
        color: var(--gold);
      }

      /* ------- tracklist (workshops as A-side / B-side) ------- */
      .tracklist {
        background: var(--cream);
        color: var(--ink);
        margin: 2mm 0;
        padding: 4mm 5mm;
        position: relative;
        border-top: 0.4mm solid var(--gold-d);
        border-bottom: 0.4mm solid var(--gold-d);
      }
      .tracklist::before, .tracklist::after {
        content: '';
        position: absolute;
        left: 0; right: 0;
        height: 0.15mm;
        background: var(--gold-d);
      }
      .tracklist::before { top: 0.6mm; }
      .tracklist::after  { bottom: 0.6mm; }

      .tracks-header {
        display: flex; align-items: center; justify-content: center;
        gap: 3mm;
        margin-bottom: 2.5mm;
      }
      .tracks-header .badge {
        font-family: 'Limelight', serif;
        font-size: 7pt;
        letter-spacing: 0.3em;
        color: var(--burgundy);
        text-transform: uppercase;
        background: var(--cream-2);
        padding: 1mm 2.5mm;
        border-radius: 1mm;
      }
      .tracks-header .ornament {
        font-size: 10pt;
        color: var(--gold-d);
      }

      .track {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: baseline;
        gap: 3mm;
        padding: 2.5mm 0;
        border-bottom: 0.15mm dashed rgba(11,13,26,0.25);
      }
      .track:last-child { border-bottom: 0; }

      .track .side {
        font-family: 'Limelight', serif;
        font-size: 9pt;
        color: var(--burgundy);
        letter-spacing: 0.16em;
        text-transform: uppercase;
        width: 11mm;
      }
      .track .num {
        font-family: 'Anton', sans-serif;
        font-size: 14pt;
        color: var(--gold-d);
        letter-spacing: 0.04em;
      }
      .track .info {
        display: flex; flex-direction: column;
        gap: 0.5mm;
      }
      .track .info .title {
        font-family: 'Cormorant Garamond', serif;
        font-weight: 700;
        font-size: 13.5pt;
        line-height: 1.05;
        color: var(--ink);
      }
      .track .info .sub {
        font-family: 'Inter', sans-serif;
        font-size: 8pt;
        color: rgba(11,13,26,0.7);
        line-height: 1.35;
        font-style: italic;
      }
      .track .info .level {
        font-family: 'Limelight', serif;
        font-size: 6.5pt;
        letter-spacing: 0.2em;
        color: var(--teal);
        text-transform: uppercase;
        margin-top: 0.5mm;
      }
      .track .duration {
        font-family: 'Anton', sans-serif;
        font-size: 12pt;
        color: var(--ink);
        letter-spacing: 0.04em;
        white-space: nowrap;
      }

      /* ------- venue + donation row ------- */
      .info-row {
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        gap: 4mm;
        margin: 3mm 0 2mm;
        color: var(--cream);
      }
      .info-row .left, .info-row .right {
        display: flex; align-items: center; gap: 2mm;
        font-family: 'Cormorant Garamond', serif;
        font-size: 10pt;
        line-height: 1.25;
      }
      .info-row .left {
        justify-content: flex-end; text-align: right;
      }
      .info-row .right {
        justify-content: flex-start;
      }
      .info-row .ico {
        width: 4mm; height: 4mm;
        color: var(--gold);
        flex: 0 0 4mm;
      }
      .info-row .ico svg { width: 100%; height: 100%; }
      .info-row .sep {
        width: 1.4mm; height: 1.4mm;
        background: var(--gold);
        transform: rotate(45deg);
      }
      .info-row strong {
        color: var(--gold);
        font-style: normal;
        font-weight: 700;
        letter-spacing: 0.02em;
      }

      /* ------- footer ------- */
      .footer {
        margin-top: auto;
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 5mm;
        padding-top: 4mm;
        border-top: 0.2mm solid rgba(212,167,44,0.4);
      }
      .footer .info-block .small {
        font-family: 'Limelight', serif;
        font-size: 7pt;
        letter-spacing: 0.28em;
        color: var(--gold);
        text-transform: uppercase;
        margin-bottom: 1mm;
      }
      .footer .info-block .big {
        font-family: 'Anton', sans-serif;
        font-size: 18pt;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--cream);
        line-height: 1;
      }
      .footer .info-block .url {
        font-family: 'Cormorant Garamond', serif;
        font-style: italic;
        font-size: 10pt;
        color: var(--gold);
        margin-top: 1.5mm;
      }
      .footer .qr {
        display: flex; flex-direction: column; align-items: center; gap: 1mm;
      }
      .footer .qr .wrap {
        padding: 1.6mm;
        background: var(--cream);
        border: 0.3mm solid var(--gold);
      }
      .footer .qr .wrap img {
        display: block;
        width: 22mm; height: 22mm;
        image-rendering: pixelated;
      }
      .footer .qr .cap {
        font-family: 'Limelight', serif;
        font-size: 6pt;
        letter-spacing: 0.24em;
        color: var(--gold);
        text-transform: uppercase;
      }

      /* ------- corner ornaments ------- */
      .corner {
        position: absolute;
        width: 14mm; height: 14mm;
        border: 0.3mm solid var(--gold);
        z-index: 1;
        pointer-events: none;
      }
      .corner::before, .corner::after {
        content: ''; position: absolute;
        background: var(--gold);
      }
      .corner::before {
        width: 1.6mm; height: 1.6mm;
        transform: rotate(45deg);
      }
      .corner.tl { top: 7mm;     left: 7mm;     border-right: 0; border-bottom: 0; }
      .corner.tr { top: 7mm;     right: 7mm;    border-left: 0;  border-bottom: 0; }
      .corner.bl { bottom: 7mm;  left: 7mm;     border-right: 0; border-top: 0; }
      .corner.br { bottom: 7mm;  right: 7mm;    border-left: 0;  border-top: 0; }
      .corner.tl::before { right: -0.8mm;  bottom: -0.8mm; }
      .corner.tr::before { left:  -0.8mm;  bottom: -0.8mm; }
      .corner.bl::before { right: -0.8mm;  top:    -0.8mm; }
      .corner.br::before { left:  -0.8mm;  top:    -0.8mm; }

      @media print {
        body { background: #fff; }
        .flyer { margin: 0; box-shadow: none; }
        .print-hint { display: none !important; }
      }

      .print-hint {
        position: fixed; top: 12px; right: 12px; z-index: 10;
        display: flex; gap: 8px; align-items: center;
        background: var(--ink); color: var(--cream);
        padding: 8px 10px 8px 14px;
        font-size: 12px; border-radius: 8px;
        font-family: 'Inter', sans-serif;
        box-shadow: 0 6px 20px rgba(0,0,0,0.3);
        border: 0.5px solid var(--gold);
      }
      .print-hint button {
        background: var(--gold); color: var(--ink);
        border: 0; padding: 6px 12px; border-radius: 6px;
        font-size: 12px; font-weight: 700; font-family: inherit;
        cursor: pointer;
      }
      .print-hint button:hover { background: var(--cream); }
    </style>
  </head>
  <body>
    <div class="print-hint">
      <span>A5 Flyer · Art Deco</span>
      <button id="btn-pdf" type="button" title="Druck-Dialog → Als PDF speichern">PDF (Print)</button>
      <span style="opacity:0.6; font-size:11px;" title="für pixelgenauen Export: npm run flyer:export">npm run flyer:export</span>
    </div>

    <div class="flyer">
      <!-- background art -->
      <div class="sunburst"></div>
      <div class="frame"></div>
      <div class="corner tl"></div>
      <div class="corner tr"></div>
      <div class="corner bl"></div>
      <div class="corner br"></div>

      <div class="content">
        <!-- top mark -->
        <div class="top-mark">
          <div class="est">Amadeus Shagadeus</div>
          <div class="divider">
            <span class="bar"></span>
            <span class="diamond"></span>
            <span class="bar"></span>
          </div>
        </div>

        <!-- hero -->
        <section class="hero">
          <div class="pres">präsentiert einen Tanzkurs in</div>
          <h1>
            <span class="collegiate">Collegiate</span>
            <span class="shag">Shag</span>
          </h1>
          <div class="tag">zu schneller, mitreißender Jazz-Musik der 1930er</div>
        </section>

        <!-- ornamental divider -->
        <div class="ornament-row" aria-hidden="true">
          <span class="orn-bar"></span>
          <span class="orn-diamond"></span>
          <span class="orn-star">✦</span>
          <span class="orn-diamond"></span>
          <span class="orn-bar"></span>
        </div>

        <!-- date -->
        <div class="when">
          <div class="day">Donnerstag</div>
          <div class="date">18 · Juni <span class="year">2026</span></div>
        </div>

        <!-- tracklist -->
        <section class="tracklist">
          <div class="tracks-header">
            <span class="ornament">❦</span>
            <span class="badge">Workshops</span>
            <span class="ornament">❦</span>
          </div>

          <div class="track">
            <span class="num">01</span>
            <div class="info">
              <div class="title">Eine kleine Shagmusik</div>
              <div class="sub">Du hast noch nie Shag getanzt und möchtest es kennenlernen? In diesem Kurs lernst du die Grundlagen und einfache Figuren.</div>
              <div class="level">Beginner · Einstieg</div>
            </div>
            <span class="duration">18:00<br/><span style="font-size:7.5pt; color:rgba(11,13,26,0.6);">55 min</span></span>
          </div>

          <div class="track">
            <span class="num">02</span>
            <div class="info">
              <div class="title">Shag Me Amadeus</div>
              <div class="sub">Du bist bereits mit den Grundschritten in verschiedenen Positionen vertraut. In diesem Kurs erweitern wir unser Figuren Repertoire.</div>
              <div class="level">Improver · Aufbau</div>
            </div>
            <span class="duration">19:00<br/><span style="font-size:7.5pt; color:rgba(11,13,26,0.6);">55 min</span></span>
          </div>
        </section>

        <!-- info row: venue + donation -->
        <div class="info-row">
          <div class="left">
            <span>Pfarrsaal St. Severin<br/>Ernst-Mach-Straße 39<br/>5023 Salzburg</span>
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/></svg>
            </span>
          </div>
          <span class="sep"></span>
          <div class="right">
            <span class="ico" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            </span>
            <span><strong>Freiwillige Spende</strong><br/>zur Deckung der Saalmiete</span>
          </div>
        </div>

        <!-- footer -->
        <div class="footer">
          <div class="info-block">
            <div class="small">Anmeldung & Infos</div>
            <div class="big">shagadeus.at</div>
            <div class="url">Weitere Termine &amp; alle Details online</div>
          </div>

          <div class="qr">
            <div class="wrap">
              <img
                src="https://api.qrserver.com/v1/create-qr-code/?size=300x300&margin=0&data=https%3A%2F%2Fshagadeus.at%2Fde%2Fworkshops%2F"
                alt="QR Code zu shagadeus.at"
              />
            </div>
            <span class="cap">scan me</span>
          </div>
        </div>
      </div>
    </div>

    <script type="module">
      const btnPdf = document.getElementById('btn-pdf');
      btnPdf?.addEventListener('click', () => window.print());
    </script>
  </body>
</html>
