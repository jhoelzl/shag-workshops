---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/index';
import { supabase } from '../../lib/supabase';
import { simpleMarkdown } from '../../lib/markdown';
import type { ClassSession } from '../../lib/database.types';

const locale = 'en';
const i18n = t(locale);

// Fetch all public classes
const { data: publicClassesData } = await supabase
  .from('dance_classes')
  .select('*, image_url, image_overlay_alpha, headline_color')
  .eq('is_public', true);
const publicClasses = publicClassesData ?? [];

const classIds = publicClasses.map((danceClass) => danceClass.id);

const { data: classSessionsData } = classIds.length > 0
  ? await supabase
      .from('class_sessions')
      .select('*')
      .in('dance_class_id', classIds)
      .order('session_date', { ascending: true })
      .order('start_time', { ascending: true })
  : { data: [] as ClassSession[] };
const classSessions = classSessionsData ?? [];

const sessionsByClass = classSessions.reduce((acc, session) => {
  if (!acc.has(session.dance_class_id)) {
    acc.set(session.dance_class_id, []);
  }
  acc.get(session.dance_class_id)!.push(session);
  return acc;
}, new Map<string, ClassSession[]>());

// Get current date for comparison
const now = new Date();

// Filter archived classes (classes with all sessions in the past)
const archivedClasses = publicClasses
  .map((danceClass) => ({
    ...danceClass,
    sessions: sessionsByClass.get(danceClass.id) || [],
  }))
  .filter((dc) => {
    const sessions = dc.sessions || [];
    if (sessions.length === 0) return false;
    // Check if all sessions are in the past
    const lastSession = sessions[sessions.length - 1];
    const lastSessionDate = new Date(lastSession.session_date);
    return lastSessionDate < now;
  })
  .sort((a, b) => {
    // Sort by last session date, newest first
    const lastA = a.sessions[a.sessions.length - 1];
    const lastB = b.sessions[b.sessions.length - 1];
    if (!lastA || !lastB) return 0;
    return new Date(lastB.session_date).getTime() - new Date(lastA.session_date).getTime();
  });

const dtLocale = 'en-AT';

function getDateRange(sessions: ClassSession[]) {
  if (sessions.length === 0) return '';
  const first = new Date(sessions[0].session_date);
  const last = new Date(sessions[sessions.length - 1].session_date);
  const firstStr = first.toLocaleDateString(dtLocale, { month: 'short', year: 'numeric' });
  const lastStr = last.toLocaleDateString(dtLocale, { month: 'short', year: 'numeric' });
  if (firstStr === lastStr) {
    return first.toLocaleDateString(dtLocale, { month: 'long', year: 'numeric' });
  }
  return `${firstStr} – ${lastStr}`;
}
---

<BaseLayout title="Archive" locale={locale} currentPath="/archive/">
  <section class="relative overflow-hidden">
    <div class="blob bg-teal/25 w-96 h-96 -top-32 -right-20 animate-float-slow"></div>
    <div class="blob bg-coral/20 w-80 h-80 -top-20 -left-20"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-14 pb-6 sm:pt-20">
      <div class="text-center mb-8 animate-fade-up">
        <p class="eyebrow text-coral mb-3">Past Workshops</p>
        <h1 class="font-display text-5xl sm:text-6xl font-black text-primary tracking-tight mb-4">
          Archive
        </h1>
        <span class="section-divider">
          <span class="text-accent text-lg">✦</span>
        </span>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 pb-12">
    {archivedClasses.length === 0 ? (
      <div class="flex flex-col items-center justify-center gap-4 rounded-3xl border border-accent/20 bg-gradient-to-br from-bg-warm via-accent/[0.07] to-coral/[0.08] shadow-soft px-6 py-14 text-center">
        <span class="flex h-14 w-14 items-center justify-center rounded-2xl bg-accent/15 text-accent-dark">
          <svg class="h-7 w-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2" stroke-width="1.8" />
            <path d="M16 2v4M8 2v4M3 10h18" stroke-width="1.8" stroke-linecap="round" />
          </svg>
        </span>
        <p class="font-display text-xl font-bold text-primary">No Workshops in Archive Yet</p>
        <p class="max-w-sm text-sm text-text-muted">Past workshops will appear here in the future.</p>
      </div>
    ) : (
      <div class="space-y-6">
        {archivedClasses.map((dc, index) => {
          const title = dc.title_en;
          const description = dc.description_en;
          const sessions = dc.sessions || [];

          const alpha = dc.image_overlay_alpha ?? 40;
          const isDark = dc.headline_color !== 'black';
          const overlayOpacity = Math.max(alpha / 100 * 0.7, 0);

          return (
            <article class="group bg-surface rounded-3xl border border-bg-warm overflow-hidden hover:shadow-lift transition-all duration-500 animate-fade-up" style={`animation-delay: ${index * 80}ms`}>
              <div class={`flex flex-col ${dc.image_url ? 'lg:flex-row' : ''} ${index % 2 === 1 && dc.image_url ? 'lg:flex-row-reverse' : ''}`}>
                {/* Image Section */}
                {dc.image_url && (
                  <div class="relative lg:w-2/5 xl:w-1/3 min-h-[200px] lg:min-h-[320px]">
                    <div
                      class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-105"
                      style={`background-image: url(${dc.image_url})`}
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent lg:bg-gradient-to-r lg:from-transparent lg:via-black/10 lg:to-black/40" />
                    <div class="absolute inset-0" style={`background: linear-gradient(${index % 2 === 1 ? 'to left' : 'to right'}, transparent 0%, rgba(0,0,0,${overlayOpacity * 0.5}) 100%)`} />

                    {/* Level badge on image */}
                    {dc.level && (
                      <span class="absolute top-4 left-4 text-[11px] uppercase tracking-wider font-bold px-3 py-1.5 rounded-full bg-white/95 text-primary shadow-lg backdrop-blur-sm">
                        {dc.level}
                      </span>
                    )}

                    {/* Dance style badge */}
                    {dc.dance && (
                      <span class="absolute bottom-4 left-4 text-xs font-bold uppercase tracking-[0.15em] text-white/90 drop-shadow-lg">
                        <span class="inline-flex items-center gap-2">
                          <span class="w-2 h-2 rounded-full bg-amber-300" />
                          {dc.dance}
                        </span>
                      </span>
                    )}
                  </div>
                )}

                {/* Content Section */}
                <div class="flex-1 p-6 lg:p-8 flex flex-col">
                  {/* Header */}
                  <div class="mb-4">
                    {!dc.image_url && dc.dance && (
                      <span class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-[0.15em] text-accent-dark mb-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-accent-dark" />
                        {dc.dance}
                      </span>
                    )}
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="font-display text-2xl lg:text-3xl font-bold text-primary leading-tight">
                        {title}
                      </h3>
                      {!dc.image_url && dc.level && (
                        <span class="text-[11px] uppercase tracking-wider font-bold px-3 py-1.5 rounded-full bg-teal/10 text-teal-dark shrink-0">
                          {dc.level}
                        </span>
                      )}
                    </div>
                  </div>

                  {/* Meta info row */}
                  <div class="flex flex-wrap gap-4 mb-5 pb-5 border-b border-bg-warm">
                    {sessions.length > 0 && (
                      <div class="flex items-center gap-2 text-sm">
                        <div class="w-8 h-8 rounded-xl bg-teal/10 flex items-center justify-center">
                          <svg class="w-4 h-4 text-teal-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <rect x="3" y="4" width="18" height="18" rx="2" stroke-width="2" />
                            <path d="M16 2v4M8 2v4M3 10h18" stroke-width="2" stroke-linecap="round" />
                          </svg>
                        </div>
                        <div>
                          <p class="font-medium text-text">{getDateRange(sessions)}</p>
                          <p class="text-xs text-text-muted">{sessions.length} {sessions.length === 1 ? 'session' : 'sessions'}</p>
                        </div>
                      </div>
                    )}

                    {dc.location && (
                      <div class="flex items-center gap-2 text-sm">
                        <div class="w-8 h-8 rounded-xl bg-coral/10 flex items-center justify-center">
                          <svg class="w-4 h-4 text-coral" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd" />
                          </svg>
                        </div>
                        <div>
                          <p class="font-medium text-text">{dc.location}</p>
                          {dc.location_details && (
                            <p class="text-xs text-text-muted truncate max-w-[200px]">{dc.location_details}</p>
                          )}
                        </div>
                      </div>
                    )}

                    {dc.teachers && (
                      <div class="flex items-center gap-2 text-sm">
                        <div class="w-8 h-8 rounded-xl bg-accent/10 flex items-center justify-center">
                          <svg class="w-4 h-4 text-accent-dark" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
                          </svg>
                        </div>
                        <div>
                          <p class="font-medium text-text">{dc.teachers}</p>
                          <p class="text-xs text-text-muted">Instructor{dc.teachers.includes('&') || dc.teachers.includes('and') ? 's' : ''}</p>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Description - full text, no truncation */}
                  {description && (
                    <div class="prose prose-sm max-w-none text-text leading-relaxed flex-grow [&_p]:mb-3 [&_p:last-child]:mb-0 [&_strong]:text-primary [&_ul]:list-disc [&_ul]:ml-5 [&_li]:marker:text-accent" set:html={simpleMarkdown(description)} />
                  )}
                </div>
              </div>
            </article>
          );
        })}
      </div>
    )}

    <div class="mt-10 text-center">
      <a
        href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/${locale}/workshops/`}
        class="inline-flex items-center gap-2 text-teal-dark hover:text-primary font-medium transition-colors"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        Back to current workshops
      </a>
    </div>
  </div>
</BaseLayout>
