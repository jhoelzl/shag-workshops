---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/index';
import WorkshopPage from '../../components/WorkshopPage';
import { supabase } from '../../lib/supabase';
import type { DanceClass, ClassSession } from '../../lib/database.types';

const locale = 'en';
const i18n = t(locale);

const siteOrigin = 'https://shagadeus.at';
const { data: publicClassesData } = await supabase
  .from('dance_classes')
  .select('*')
  .eq('is_public', true);
const publicClasses = publicClassesData ?? [];

const classIds = publicClasses.map((danceClass) => danceClass.id);

const { data: classCountsData } = classIds.length > 0
  ? await supabase
      .from('class_registration_counts')
      .select('*')
      .in('dance_class_id', classIds)
  : { data: [] };

const { data: classSessionsData } = classIds.length > 0
  ? await supabase
      .from('class_sessions')
      .select('*')
      .in('dance_class_id', classIds)
      .order('session_date', { ascending: true })
      .order('start_time', { ascending: true })
  : { data: [] as ClassSession[] };
const classSessions = classSessionsData ?? [];
const classCounts = classCountsData ?? [];

const sessionsByClass = classSessions.reduce((acc, session) => {
  if (!acc.has(session.dance_class_id)) {
    acc.set(session.dance_class_id, []);
  }
  acc.get(session.dance_class_id)!.push(session);
  return acc;
}, new Map<string, ClassSession[]>());

const countsByClass = classCounts.reduce((acc, counts) => {
  if (!counts.dance_class_id) return acc;
  acc.set(counts.dance_class_id, counts);
  return acc;
}, new Map<string, { leads_available: number | null; follows_available: number | null }>());

const initialClasses = publicClasses
  .map((danceClass: DanceClass) => {
    const counts = countsByClass.get(danceClass.id);
    return {
      ...danceClass,
      leads_available: Number(counts?.leads_available ?? danceClass.max_leads),
      follows_available: Number(counts?.follows_available ?? danceClass.max_follows),
      sessions: sessionsByClass.get(danceClass.id) || [],
    };
  })
  .sort((a, b) => {
    const firstA = a.sessions?.[0];
    const firstB = b.sessions?.[0];

    if (!firstA && !firstB) return 0;
    if (!firstA) return 1;
    if (!firstB) return -1;

    const firstDateTimeA = `${firstA.session_date}T${firstA.start_time}`;
    const firstDateTimeB = `${firstB.session_date}T${firstB.start_time}`;
    return firstDateTimeA.localeCompare(firstDateTimeB);
  });

const eventJsonLd = publicClasses.flatMap((danceClass: DanceClass) => {
  const sessions = sessionsByClass.get(danceClass.id) || [];
  return sessions.map((session) => {
    const startDate = `${session.session_date}T${session.start_time}`;
    const endDate = `${session.session_date}T${session.end_time}`;

    return {
      '@context': 'https://schema.org',
      '@type': 'Event',
      name: danceClass.title_en,
      description: danceClass.description_en || undefined,
      eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
      eventStatus: 'https://schema.org/EventScheduled',
      startDate,
      endDate,
      location: {
        '@type': 'Place',
        name: danceClass.location || 'Salzburg',
        address: danceClass.location_details || undefined,
      },
      offers: {
        '@type': 'Offer',
        price: danceClass.price_eur ?? 0,
        priceCurrency: 'EUR',
        availability: 'https://schema.org/InStock',
        url: `${siteOrigin}/en/workshops/?class=${danceClass.id}`,
      },
    };
  });
});
---

<BaseLayout title="Collegiate Shag Swing Dance Workshops in Salzburg" locale={locale} currentPath="/workshops/">
  {eventJsonLd.map((event) => (
    <script slot="head" type="application/ld+json" set:html={JSON.stringify(event)} />
  ))}

  <section class="relative overflow-hidden">
    <div class="blob bg-teal/25 w-96 h-96 -top-32 -right-20 animate-float-slow"></div>
    <div class="blob bg-coral/20 w-80 h-80 -top-20 -left-20"></div>

    <div class="relative max-w-6xl mx-auto px-6 pt-14 pb-6 sm:pt-20">
      <div class="text-center mb-8 animate-fade-up">
        <p class="eyebrow text-coral mb-3">Program</p>
        <h1 class="font-display text-5xl sm:text-6xl font-black text-primary tracking-tight mb-4">
          {i18n.workshops.title}
        </h1>
        <span class="section-divider">
          <span class="text-accent text-lg">✦</span>
        </span>
      </div>
    </div>
  </section>

  <div class="max-w-6xl mx-auto px-6 pb-12">
    <WorkshopPage client:load locale={locale} initialClasses={initialClasses} />
  </div>
</BaseLayout>
